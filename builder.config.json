{
  "version": 1,
  "packageVersion": "1.0.1-alpha",
  "artifactsRoot": "artifacts",
  "localPackageFeed": "artifacts/packages",
  "defaultBranch": "main",
  "developmentBranch": "development",
  "groups": [
    {
      "name": "KoreForge packages",
      "paths": [
        "eco-system/KoreForge.Time",
        "eco-system/KoreForge.Jex",
        "eco-system/KoreForge.Json",
        "eco-system/KoreForge.Data",
        "eco-system/KoreForge.OData",
        "eco-system/KoreForge.Metrics",
        "eco-system/KoreForge.Metrics.AspNet",
        "eco-system/KoreForge.Logging",
        "eco-system/KoreForge.Logging.Serilog",
        "eco-system/KoreForge.Processing",
        "eco-system/KoreForge.AppLifecycle",
        "eco-system/KoreForge.Kafka",
        "eco-system/KoreForge.Web",
        "eco-system/KoreForge.Settings",
        "eco-system/KoreForge.Scripts",
        "eco-system/KoreForge.Monitoring",
        "eco-system/KoreForge.Templates"
      ]
    },
    {
      "name": "KoreForge tools",
      "paths": [
        "tools/KoreForge.Jex.Cli",
        "tools/KoreForge.Jex.LanguageServer",
        "tools/KoreForge.Jex.VSCodeExtension",
        "tools/KoreForge.NuGet.IntegrationTests"
      ]
    },
    {
      "name": "KoreForge npm",
      "paths": [
        "eco-web/KoreForge.Scripts.Vue",
        "eco-web/KoreForge.Monitoring.Shell",
        "eco-web/KoreForge.Jex.Vue",
        "eco-web/KoreForge.Kafka.Vue"
      ]
    },
    {
      "name": "Event test apps",
      "paths": [
        "event/Event.Streaming",
        "event/Event.Processor",
        "event/Event.Reader",
        "event/Event.Benchmarks",
        "event/Event.Writer"
      ]
    }
  ]
}
